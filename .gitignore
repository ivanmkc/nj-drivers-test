# Source manuals now live at data/states/<code>/manual.{pdf,txt} (PDFs via Git LFS,
# see .gitattributes). The legacy root-level drivermanual.pdf / manual_text.txt
# patterns from the NJ-only era are no longer ignored.
__pycache__/
*.pyc
.env
.DS_Store
venv/
*.egg-info/

# Android
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/

# iOS
ios/DriversTest/build/
ios/DriversTest/DerivedData/
ios/DriversTest/*.xcworkspace/xcuserdata/
ios/DriversTest/*.xcodeproj/xcuserdata/
ios/DriversTest/*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/

# Generated bundles (rebuilt by tools/bundle.py at build time)
shared/
ios/DriversTest/DriversTest/Resources/questions_bundle.json.gz
ios/DriversTest/DriversTest/Resources/signs/
android/app/src/main/assets/questions_bundle.json.gz
android/app/src/main/assets/signs/

# Frontend
frontend/node_modules/
frontend/dist/

# Built docs assets (rebuilt by vite build)
docs/assets/
frontend/public/questions_bundle.json
frontend/public/signs
frontend/public/i18n.json
frontend/tsconfig.tsbuildinfo
