# Source manuals now live at data/states/<code>/manual.{pdf,txt} (PDFs via Git LFS,
# see .gitattributes). The legacy root-level drivermanual.pdf / manual_text.txt
# patterns from the NJ-only era are no longer ignored.
__pycache__/
*.pyc
.env
.DS_Store
venv/
*.egg-info/

# Android
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/

# iOS
ios/DriversTest/build/
ios/DriversTest/DerivedData/
ios/DriversTest/*.xcworkspace/xcuserdata/
ios/DriversTest/*.xcodeproj/xcuserdata/
ios/DriversTest/*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/

# Generated bundles (rebuilt by tools/bundle.py at build time)
shared/
ios/DriversTest/DriversTest/Resources/questions_bundle.json.gz
ios/DriversTest/DriversTest/Resources/signs/
android/app/src/main/assets/questions_bundle.json.gz
android/app/src/main/assets/signs/

# Claude Code workspace state
.claude/worktrees/
.claude/commands/
.claude/skills/openspec-*
.claude/settings.local.json

# Frontend
frontend/node_modules/
frontend/dist/

# Web build output (vite build -> site/, uploaded by deploy-pages.yml)
site/
frontend/tsconfig.tsbuildinfo
frontend/playwright-report/
frontend/test-results/

# Web data written by tools/bundle.py into frontend/public (rebuilt every build)
frontend/public/data/
frontend/public/signs/

# Static pages generated by tools/build_site_pages.py (run in deploy-pages.yml)
frontend/public/about/
frontend/public/privacy/
frontend/public/support/
frontend/public/404.html
